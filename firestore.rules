rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users — each user can read/write only their own profile.
    // Stat fields (totalClips, streakCurrent, streakBest, lastClipDay,
    // friendsCount, referralsCount) are written by Cloud Functions only; the
    // client cannot alter them directly. The handle field is owned by the
    // client through a transaction that touches /usernames/{handle} for
    // uniqueness. `referredByUid` is allowed at create only (must reference
    // someone other than the new user) and is immutable after that — the
    // `onUserCreated` trigger reads it once to credit the referrer.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && (!('referredByUid' in request.resource.data)
                        || (request.resource.data.referredByUid is string
                            && request.resource.data.referredByUid.size() > 0
                            && request.resource.data.referredByUid.size() <= 64
                            && request.resource.data.referredByUid != uid));
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys()
                       .hasAny(['totalClips','streakCurrent','streakBest','lastClipDay','friendsCount','referralsCount','referredByUid']);
      allow delete: if false;
    }

    // Username uniqueness lock. The doc id is the lowercased handle; the doc
    // body is `{ uid, claimedAt }`. Anyone can read (handle search needs it).
    // Create only if free. Delete only if you own it (handle change releases
    // the old one in the same transaction). Update is never allowed — to
    // change owners, delete and re-create.
    match /usernames/{handle} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Blips — only members can read; only owner can update size/name; members can self-leave.
    match /blips/{blipId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.size is int
                    && request.resource.data.size >= 1
                    && request.resource.data.size <= 10;

      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerUid
                        || isLeavingSelf(resource.data.members, request.resource.data.members));

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;

      // Days — derived state, written only by Cloud Functions (admin SDK bypasses rules).
      // Members can read.
      match /days/{dateKey} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/blips/$(blipId)).data.members;
        allow write: if false;

        match /clips/{clipId} {
          allow read: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/blips/$(blipId)).data.members;

          allow create: if request.auth != null
                        && request.resource.data.uid == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/blips/$(blipId)).data.members
                        && request.resource.data.hour is int
                        && request.resource.data.hour >= 0
                        && request.resource.data.hour <= 23
                        && request.resource.data.durationSeconds is number
                        && request.resource.data.durationSeconds >= 1.8
                        && request.resource.data.durationSeconds <= 2.5;

          allow update: if request.auth != null
                        && request.auth.uid == resource.data.uid
                        && onlyEditableFieldsChanged(resource.data, request.resource.data);

          allow delete: if request.auth != null
                        && request.auth.uid == resource.data.uid;
        }
      }

      // Blipchat text thread (screen-11)
      match /messages/{msgId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/blips/$(blipId)).data.members;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/blips/$(blipId)).data.members;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      }

      // Peer nudges. Doc id is deterministic — `{dateKey}_{hour}_{senderUid}_{nudgeeUid}`
      // in the blip's local TZ — so a re-nudge in the same hour collides with the
      // existing doc, the create rule no-ops (the SDK falls through to update),
      // and update is denied. That collision is the throttle.
      match /nudges/{nudgeId} {
        allow read: if false;  // server-only; clients never list nudges
        allow create: if request.auth != null
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.nudgeeUid is string
                      && request.resource.data.nudgeeUid != request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/blips/$(blipId)).data.members
                      && request.resource.data.nudgeeUid in get(/databases/$(database)/documents/blips/$(blipId)).data.members;
        allow update, delete: if false;
      }
    }

    // Friend requests — top-level. Doc id is deterministic — `{fromUid}_{toUid}`
    // — so a re-send collides with the existing doc and the create rule denies
    // the resulting update. Lifecycle: pending → (accepted | rejected). The
    // recipient owns the flip; the sender can delete only while still pending.
    match /friend_requests/{requestId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.fromUid
                      || request.auth.uid == resource.data.toUid);

      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.fromUid != request.resource.data.toUid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
                    && request.auth.uid == resource.data.toUid
                    && resource.data.status == 'pending'
                    && (request.resource.data.status == 'accepted'
                        || request.resource.data.status == 'rejected')
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'respondedAt']);

      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.fromUid
                    && resource.data.status == 'pending';
    }

    // Friendships — subcollection-scoped under each user. Each side keeps its
    // own half (`/users/{uid}/friends/{friendUid}`) so the listener query is
    // trivial and a Phase 2 Cloud Function can trigger off the doc create to
    // bump `friendsCount`. Creates require a matching accepted friend_request
    // (in either direction). Deletes are allowed by either endpoint so the
    // unfriend service can atomically remove both halves from one client.
    match /users/{uid}/friends/{friendUid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == friendUid
                    && (
                         (exists(/databases/$(database)/documents/friend_requests/$(uid + '_' + friendUid))
                          && get(/databases/$(database)/documents/friend_requests/$(uid + '_' + friendUid)).data.status == 'accepted')
                         || (exists(/databases/$(database)/documents/friend_requests/$(friendUid + '_' + uid))
                             && get(/databases/$(database)/documents/friend_requests/$(friendUid + '_' + uid)).data.status == 'accepted')
                       );

      allow update: if false;

      allow delete: if request.auth != null
                    && (request.auth.uid == uid || request.auth.uid == friendUid);
    }
  }

  // Helpers

  function isLeavingSelf(oldMembers, newMembers) {
    return request.auth.uid in oldMembers
        && !(request.auth.uid in newMembers)
        && newMembers.size() == oldMembers.size() - 1;
  }

  // Only allow caption edits via the long-press menu (screen-10 "edit caption").
  function onlyEditableFieldsChanged(oldData, newData) {
    return newData.diff(oldData).affectedKeys().hasOnly(['caption']);
  }
}
