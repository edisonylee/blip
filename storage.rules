rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Raw clips: blips/{blipId}/days/{dateKey}/{uid}/{hour}.mov
    // Uploader must be the authenticated user and a member of the blip.
    match /blips/{blipId}/days/{dateKey}/{uid}/{file} {
      allow read: if request.auth != null
                  && firestore.exists(/databases/(default)/documents/blips/$(blipId))
                  && request.auth.uid in firestore.get(/databases/(default)/documents/blips/$(blipId)).data.members;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.uid in firestore.get(/databases/(default)/documents/blips/$(blipId)).data.members
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Per-user stitched export: blips/{blipId}/days/{dateKey}/exports/{uid}/stitched.mp4
    // Each member's curated stitch is private to them (different exclusion sets
    // produce different stitches). Written by Cloud Functions (admin SDK).
    match /blips/{blipId}/days/{dateKey}/exports/{uid}/stitched.mp4 {
      allow read: if request.auth != null
                  && request.auth.uid == uid
                  && firestore.exists(/databases/(default)/documents/blips/$(blipId))
                  && request.auth.uid in firestore.get(/databases/(default)/documents/blips/$(blipId)).data.members;
      allow write: if false;
    }

    // Legacy shared stitched output. Older clients (and any clip docs that
    // already point here) may still try to read it; reads stay open to members
    // for backward compatibility. Writes already blocked. Remove once nothing
    // references this path.
    match /blips/{blipId}/days/{dateKey}/stitched.mp4 {
      allow read: if request.auth != null
                  && firestore.exists(/databases/(default)/documents/blips/$(blipId))
                  && request.auth.uid in firestore.get(/databases/(default)/documents/blips/$(blipId)).data.members;
      allow write: if false;
    }
  }
}
