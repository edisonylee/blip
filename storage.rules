rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Raw clips: logs/{logId}/days/{dateKey}/{uid}/{hour}.mov
    // Uploader must be the authenticated user and a member of the log.
    match /logs/{logId}/days/{dateKey}/{uid}/{file} {
      allow read: if request.auth != null
                  && firestore.exists(/databases/(default)/documents/logs/$(logId))
                  && request.auth.uid in firestore.get(/databases/(default)/documents/logs/$(logId)).data.members;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.uid in firestore.get(/databases/(default)/documents/logs/$(logId)).data.members
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
    }

    // Stitched daily output: logs/{logId}/days/{dateKey}/stitched.mp4
    // Written by Cloud Functions (admin SDK), readable by members.
    match /logs/{logId}/days/{dateKey}/stitched.mp4 {
      allow read: if request.auth != null
                  && firestore.exists(/databases/(default)/documents/logs/$(logId))
                  && request.auth.uid in firestore.get(/databases/(default)/documents/logs/$(logId)).data.members;
      allow write: if false;
    }
  }
}
